---
import '../styles/search-entry.css';
---
<a href="/#article-search" class="search-entry" data-search-entry aria-label="検索を開く">検索</a>
<dialog class="search-dialog" aria-labelledby="search-dialog-heading" data-search-dialog>
  <div class="search-dialog-heading">
    <h2 id="search-dialog-heading">記事を検索</h2>
    <button type="button" class="search-dialog-close" data-search-close aria-label="検索を閉じる">×</button>
  </div>
  <form action="/#article-search" method="get" role="search" aria-label="サイト内検索">
    <label for="site-search-query">検索キーワード</label>
    <div class="search-dialog-fields">
      <input id="site-search-query" type="search" name="q" placeholder="キーワードを入力" autofocus />
      <button type="submit">検索する</button>
    </div>
    <p>記事一覧で検索結果を表示します。<kbd>⌘</kbd> / <kbd>Ctrl</kbd> + <kbd>K</kbd> で開けます。</p>
  </form>
</dialog>
<script>
  const entry = document.querySelector<HTMLAnchorElement>('[data-search-entry]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('#site-search-query');
  if (entry && dialog && input && typeof dialog.showModal === 'function') {
    let previousFocus: HTMLElement | null = null;
    function openSearch() {
      if (!dialog || !input) return;
      if (!dialog.open) {
        previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        dialog.showModal();
      }
      input.focus();
    }
    entry.addEventListener('click', (event) => {
      if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      openSearch();
    });
    document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => previousFocus?.focus({ preventScroll: true }));
    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (event.isComposing || event.repeat || event.altKey || !(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== 'k') return;
      if (target instanceof HTMLElement && (target.isContentEditable || target.closest('input, textarea, select'))) return;
      event.preventDefault();
      openSearch();
    });
  }
</script>
