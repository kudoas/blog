---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles } from '../../lib/content';
import { collectTerms, tagUrl } from '../../lib/articles';
const tags = collectTerms(await getArticles());
---
<BaseLayout title="タグ">
  <h1>タグから探す</h1>
  <ul class="term-list">{tags.map(({ label, count }) => <li><a href={tagUrl(label)}>#{label}</a> ({count}件)</li>)}</ul>
</BaseLayout>
