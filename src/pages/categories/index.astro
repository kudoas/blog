---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles } from '../../lib/content';
import { collectTerms } from '../../lib/articles';
const categories = collectTerms(await getArticles(), 'categories');
---
<BaseLayout title="カテゴリ">
  <h1>カテゴリ</h1>
  <ul class="term-list">{categories.map(({ slug, label, count }) => <li><a href={`/categories/${encodeURIComponent(slug)}/`}>{label}</a> ({count}件)</li>)}</ul>
</BaseLayout>
