{
  "name": "blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "26.11.1"
  },
  "repository": "ssh://git@github.com/kudoas/blog.git",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun scripts/build-search.ts",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit",
    "textlint": "textlint 'content/**/*.md'",
    "test": "node --test tests/unit/*.test.ts",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "bun run textlint && bun run check && bun run test && bun run build && bun run test:build",
    "deploy": "bun run verify && wrangler deploy",
    "preview:worker": "wrangler dev --port 8787"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kudoas/blog/issues"
  },
  "homepage": "https://github.com/kudoas/blog#readme",
    "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/react": "7.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-breaks": "4.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "pagefind": "1.5.2",
    "textlint": "15.8.0",
    "textlint-rule-preset-ja-spacing": "3.0.3",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-spellcheck-tech-word": "5.0.0",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  }
}
