<%# herb:slots client %>
<%# herb:state (pending: false, search_error: false, failed: false) %>

<section class="articles-section" aria-labelledby="articles-heading">
  <div class="section-heading"><h1 id="articles-heading">記事</h1></div>
  <div class="article-explorer" data-articles="<%= published_content.articles.to_json %>">
    <section class="saved-articles" aria-labelledby="saved-articles-heading">
      <h2 id="saved-articles-heading">あとで読む</h2>
      <ul class="saved-articles-list" data-herb-name="saved_articles">
        <% @saved_articles.each do |article| %>
          <%# herb:key article.fetch('id') %>
          <li>
            <a data-herb-name="title" href="<%= article.fetch('url') %>"><%= article.fetch('title') %></a>
            <form action="<%= remove_saved_articles_path %>" method="post" data-herb-remove>
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :article_id, article.fetch('id') %>
              <button type="submit">解除</button>
            </form>
            <% if failed %>
              <p role="alert">保存に失敗しました。再試行するか、一覧から外してください。</p>
              <button type="button" data-outbox-retry>再試行</button>
              <button type="button" data-outbox-discard>破棄</button>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if @saved_articles.length >= ReadingList::MAX_ITEMS %>
        <p class="saved-articles-limit" role="status">あとで読める記事は<%= ReadingList::MAX_ITEMS %>件までです。</p>
      <% end %>
    </section>
    <form role="search" method="get" action="/">
      <fieldset>
        <legend class="sr-only">記事を探す</legend>
        <label for="article-search" class="sr-only">記事を検索</label>
        <input id="article-search" type="search" name="q" placeholder="記事を検索" value="<%= @query %>">
        <label for="tag-filter" class="sr-only">タグで絞り込む</label>
        <select id="tag-filter" name="tag"><option value="">すべてのタグ</option>
          <% published_content.terms(:tags).each do |term| %>
            <option value="<%= term.fetch('slug') %>" <%= 'selected' if @tag == term.fetch('slug') %>><%= term.fetch('label') %></option>
          <% end %>
        </select>
      </fieldset>
    </form>
    <p class="search-help">ブログ内は本文まで、外部記事はタイトル・タグ・説明を検索します。</p>
    <% if search_error %><p class="search-help" role="alert">本文検索を読み込めませんでした。タイトル・タグから検索しています。</p><% end %>
    <div class="list-status"><p role="status" aria-live="polite" aria-atomic="true"><% if pending %>検索中…<% else %><span class="result-number"><%= @articles.length %></span> 件の記事<% if @query.present? || @tag.present? %> / 全<%= @total_count %>件<% end %><% end %></p>
      <button type="button" class="clear-search" <%= 'hidden' if @query.blank? && @tag.blank? %>>条件をクリア</button>
    </div>
    <div aria-busy="<%= pending %>">
      <%= render "articles/article_list", articles: @articles, saved_articles: @saved_articles %>
      <% if @articles.empty? %><p class="empty-state">条件に合う記事が見つかりませんでした。</p><% end %>
    </div>
  </div>
</section>
