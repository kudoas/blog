<%# herb:slots client %>
<%# herb:state (pending: false, search_error: false) %>

<section class="articles-section" aria-labelledby="articles-heading">
  <div class="section-heading"><h1 id="articles-heading">記事</h1></div>
  <div class="article-explorer" data-articles="<%= content_repository.articles.to_json %>">
    <form role="search" method="get" action="/">
      <fieldset>
        <legend class="sr-only">記事を探す</legend>
        <label for="article-search" class="sr-only">記事を検索</label>
        <input id="article-search" type="search" name="q" placeholder="記事を検索" value="<%= @query %>">
        <label for="tag-filter" class="sr-only">タグで絞り込む</label>
        <select id="tag-filter" name="tag"><option value="">すべてのタグ</option>
          <% content_repository.terms(:tags).each do |term| %>
            <option value="<%= term.fetch('slug') %>" <%= 'selected' if @tag == term.fetch('slug') %>><%= term.fetch('label') %></option>
          <% end %>
        </select>
      </fieldset>
    </form>
    <p class="search-help">ブログ内は本文まで、外部記事はタイトル・タグ・説明を検索します。</p>
    <% if search_error %><p class="search-help" role="alert">本文検索を読み込めませんでした。タイトル・タグから検索しています。</p><% end %>
    <div class="list-status"><p role="status" aria-live="polite" aria-atomic="true"><% if pending %>検索中…<% else %><span class="result-number"><%= @articles.length %></span> 件の記事<% if @query.present? || @tag.present? %> / 全<%= @total_count %>件<% end %><% end %></p>
      <button type="button" class="clear-search" <%= 'hidden' if @query.blank? && @tag.blank? %>>条件をクリア</button>
    </div>
    <div aria-busy="<%= pending %>">
      <%= render "article_list", articles: @articles %>
      <% if @articles.empty? %><p class="empty-state">条件に合う記事が見つかりませんでした。</p><% end %>
    </div>
  </div>
</section>
