<%# herb:slots client %>
<%# herb:state (pending: false, failed: false) %>
<header class="page-heading"><a class="back-link" href="<%= @base_path %>">← 一覧</a><h1><%= @heading %></h1><p class="muted"><%= @articles.length %> 件の記事</p></header>
<section class="saved-articles" aria-labelledby="saved-articles-heading">
  <h2 id="saved-articles-heading">あとで読む</h2>
  <ul class="saved-articles-list" data-herb-name="saved_articles">
    <% @saved_articles.each do |article| %>
      <%# herb:key article.fetch('id') %>
      <li>
        <a data-herb-name="title" href="<%= article.fetch('url') %>"><%= article.fetch('title') %></a>
        <form action="<%= remove_saved_articles_path %>" method="post">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <%= hidden_field_tag :article_id, article.fetch('id') %>
          <button type="submit">解除</button>
        </form>
        <% if failed %>
          <p role="alert">保存に失敗しました。再試行するか、一覧から外してください。</p>
          <button type="button" data-outbox-retry>再試行</button>
          <button type="button" data-outbox-discard>破棄</button>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if @saved_articles.length >= ReadingList::MAX_ITEMS %>
    <p class="saved-articles-limit" role="status">あとで読める記事は<%= ReadingList::MAX_ITEMS %>件までです。</p>
  <% end %>
</section>
<%= render "articles/article_list", articles: @articles, saved_articles: @saved_articles %>
