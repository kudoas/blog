<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#06192f">
  <title><%= @page_title ? "#{@page_title} | daichi/tech" : "daichi/tech" %></title>
  <meta name="description" content="<%= @description.presence || 'Ruby、Angular、Web 標準を中心に、開発で学んだことを綴るブログ。' %>">
  <link rel="canonical" href="<%= canonical_url %>">
  <link rel="icon" href="/favicon/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/favicon/apple-icon-180x180.png">
  <link rel="alternate" type="application/rss+xml" title="daichi/tech" href="/index.xml">
  <meta property="og:site_name" content="daichi/tech">
  <meta property="og:type" content="<%= @article ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= @page_title || 'daichi/tech' %>">
  <meta property="og:description" content="<%= @description.presence || 'Ruby、Angular、Web 標準を中心に、開発で学んだことを綴るブログ。' %>">
  <meta property="og:url" content="<%= canonical_url %>">
  <meta property="og:image" content="<%= "https://blog.da1chi.net/#{(@image.presence || 'img/og.png').delete_prefix('/')}" %>">
  <meta property="og:locale" content="ja_JP">
  <% if @published_at %><meta property="article:published_time" content="<%= @published_at %>"><% end %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@da1chi24">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "application" %>
  <%= stylesheet_link_tag "herb" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <header class="site-header shell">
    <a class="wordmark" href="/" aria-label="daichi/tech ホーム">daichi<span>/</span>tech</a>
    <nav aria-label="メインナビゲーション">
      <a href="/" <%= 'aria-current="page"'.html_safe if request.path == '/' %>>記事</a>
      <a href="/tags/" <%= 'aria-current="page"'.html_safe if request.path.start_with?('/tags/') %>>タグ</a>
      <a href="https://da1chi.net">About <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="main" class="shell" tabindex="-1"><%= yield %></main>
  <footer class="site-footer shell">
    <p>© <%= Time.current.year %> daichi</p>
    <nav aria-label="関連リンク">
      <a href="https://github.com/kudoas">GitHub</a>
      <a href="https://twitter.com/da1chi24">X</a>
      <a href="https://da1chi.hatenablog.jp/">はてなブログ</a>
      <a href="/index.xml">RSS</a>
    </nav>
  </footer>
</body>
</html>
