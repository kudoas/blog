{
  "name": "blog / Codex",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "",
  "workspaceFolder": "/workspaces/blog",
  "mounts": [
    "source=blog-codex-${devcontainerId}-workspace,target=/workspaces/blog,type=volume",
    "source=blog-codex-${devcontainerId}-auth,target=/home/node/.codex,type=volume",
    "source=blog-codex-${devcontainerId}-github,target=/home/node/.config/gh,type=volume",
    "source=blog-codex-${devcontainerId}-state,target=/home/node/.local/state/blog-agent,type=volume",
    "source=blog-codex-${devcontainerId}-bun,target=/home/node/.bun/install/cache,type=volume"
  ],
  "remoteUser": "node",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--shm-size=1g"
  ],
  "forwardPorts": [
    4321
  ],
  "postCreateCommand": "bash /usr/local/share/blog-devcontainer/bootstrap.sh",
  "remoteEnv": {
    "SSH_AUTH_SOCK": ""
  }
}
